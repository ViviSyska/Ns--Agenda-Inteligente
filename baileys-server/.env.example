# ---- obrigatórias ----
# Senha que o sistema usa para falar com este servidor (invente uma forte, 24+ caracteres)
API_KEY=troque-por-uma-senha-longa
# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# ATENÇÃO: é a chave "service_role" (secreta) — NUNCA coloque no index.html
SUPABASE_SERVICE_KEY=eyJ...

# ---- opcionais ----
WA_SESSION=salao
# Pausa aleatória entre mensagens do lote (milissegundos) — protege o número contra bloqueio
DELAY_MIN_MS=3000
DELAY_MAX_MS=7000
# Máximo de mensagens por lote
MAX_BULK=150
# Responder automaticamente a cliente depois que ela manda Sim/Não (true/false)
AUTO_REPLY=true
# REPLY_CONFIRMOU=Perfeito, {nome}! Sua presença está confirmada para {data} às {hora}. Te esperamos! 💛
# REPLY_RECUSOU=Tudo bem, {nome}! Cancelamos seu horário de {data} às {hora}. Quando quiser remarcar é só chamar. 💛
# Endereço do seu sistema (para travar o CORS). Em branco = qualquer origem (a API key já protege)
# CORS_ORIGIN=https://seu-sistema.netlify.app
TZ=America/Sao_Paulo
